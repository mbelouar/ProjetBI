<?xml version="1.0" encoding="UTF-8"?>
<job>
  <name>01_main_etl_job</name>
  <description>Job principal d'orchestration du pipeline ETL complet
Orchestre l'exécution de 32 transformations dans l'ordre:
- Phase 1: Extraction (8 transformations)
- Phase 2: Nettoyage (8 transformations)
- Phase 3: Enrichissement (6 transformations)
- Phase 4: Dimensions (5 transformations)
- Phase 5: Faits (3 transformations)
- Phase 6: Chargement (2 transformations)</description>
  <extended_description/>
  <job_version>1.0</job_version>
  <job_status>0</job_status>
  <directory>/</directory>
  <parameters>
  </parameters>
  <log>
    <trans-log-table>
      <connection/>
      <schema/>
      <table/>
      <size_limit_lines/>
      <interval/>
      <timeout_days/>
      <field>
        <id>ID_BATCH</id>
        <enabled>Y</enabled>
        <name>ID_BATCH</name>
      </field>
    </trans-log-table>
  </log>
  <created_user>-</created_user>
  <created_date>2026/01/06 18:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/01/06 18:00:00.000</modified_date>
  <notepads>
    <notepad>
      <note>JOB PRINCIPAL ETL - Pipeline Complet
32 transformations orchestrées automatiquement</note>
