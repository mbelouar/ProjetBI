<?xml version="1.0" encoding="UTF-8"?>
<transformation>
  <info>
    <name>05_transformation_enrichissement_factures</name>
    <description>Transformation d'enrichissement des données factures

Opérations:
- Calcul de la marge (marge = montant_ttc - cout_energie)
- Calcul du taux de marge (taux_marge = marge / montant_ttc)
- Jointure avec les paiements
- Calcul des délais de paiement
- Détermination du statut de paiement (est_paye, est_en_retard)</description>
    <extended_description/>
    <trans_version/>
    <trans_type>Normal</trans_type>
    <directory>/</directory>
    <parameters>
    </parameters>
    <log>
      <trans-log-table>
        <connection/>
        <schema/>
        <table/>
        <size_limit_lines/>
        <interval/>
        <timeout_days/>
        <field>
          <id>ID_BATCH</id>
          <enabled>Y</enabled>
          <name>ID_BATCH</name>
        </field>
      </trans-log-table>
    </log>
    <maxdate>
      <connection/>
      <table/>
      <field/>
      <offset>0.0</offset>
      <maxdiff>0.0</maxdiff>
    </maxdate>
    <size_rowset>10000</size_rowset>
    <sleep_time_empty>50</sleep_time_empty>
    <sleep_time_full>50</sleep_time_full>
    <unique_connections>N</unique_connections>
    <feedback_shown>Y</feedback_shown>
    <feedback_size>50000</feedback_size>
    <using_thread_priorities>Y</using_thread_priorities>
    <shared_objects_file/>
    <capture_step_performance>N</capture_step_performance>
    <step_performance_capturing_delay>1000</step_performance_capturing_delay>
    <step_performance_capturing_size_limit>100</step_performance_capturing_size_limit>
    <dependencies>
    </dependencies>
    <partitionschemas>
    </partitionschemas>
    <slaveservers>
    </slaveservers>
    <clusterschemas>
    </clusterschemas>
    <created_user>-</created_user>
    <created_date>2026/01/06 12:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/01/06 12:00:00.000</modified_date>
  </info>
  <notepads>
    <notepad>
      <note>ÉTAPE 1: Lecture factures nettoyées</note>
      <xloc>100</xloc>
      <yloc>50</yloc>
      <width>200</width>
      <heigth>40</heigth>
    </notepad>
    <notepad>
      <note>ÉTAPE 2: Calculs financiers
- Marge
- Taux de marge</note>
      <xloc>350</xloc>
      <yloc>50</yloc>
      <width>180</width>
      <heigth>60</heigth>
    </notepad>
    <notepad>
      <note>ÉTAPE 3: Enrichissement
- Jointure paiements
- Calcul délais</note>
      <xloc>600</xloc>
      <yloc>50</yloc>
      <width>180</width>
      <heigth>60</heigth>
    </notepad>
  </notepads>
  <order>
    <hop>
      <from>Read_Cleaned_Factures</from>
      <to>Calculate_Margin</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Calculate_Margin</from>
      <to>Lookup_Paiements</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Read_Paiements</from>
      <to>Lookup_Paiements</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Lookup_Paiements</from>
      <to>Calculate_Payment_Delay</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Calculate_Payment_Delay</from>
      <to>Determine_Payment_Status</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Determine_Payment_Status</from>
      <to>Save_Enriched_Factures</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <step>
    <name>Read_Cleaned_Factures</name>
    <type>CsvInput</type>
    <description>Lire les factures nettoyées</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <filename>${Internal.Transformation.Filename.Directory}/../../staging/transformed/factures_cleaned.csv</filename>
    <filename_field/>
    <rownum_field/>
    <include_filename>N</include_filename>
    <separator>;</separator>
    <enclosure>&quot;</enclosure>
    <header>Y</header>
    <buffer_size>50000</buffer_size>
    <lazy_conversion>Y</lazy_conversion>
    <add_filename_result>N</add_filename_result>
    <parallel>N</parallel>
    <newline_possible>N</newline_possible>
    <encoding>UTF-8</encoding>
    <fields>
      <field>
        <name>id_facture</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>20</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>id_client</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>10</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>id_batiment</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>10</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>date_facture</name>
        <type>Date</type>
        <format>yyyy-MM-dd</format>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>date_echeance</name>
        <type>Date</type>
        <format>yyyy-MM-dd</format>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>montant_ht</name>
        <type>Number</type>
        <format>#.##</format>
        <currency/>
        <decimal>.</decimal>
        <group/>
        <length>12</length>
        <precision>2</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>tva</name>
        <type>Number</type>
        <format>#.##</format>
        <currency/>
        <decimal>.</decimal>
        <group/>
        <length>12</length>
        <precision>2</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>montant_ttc</name>
        <type>Number</type>
        <format>#.##</format>
        <currency/>
        <decimal>.</decimal>
        <group/>
        <length>12</length>
        <precision>2</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>cout_energie</name>
        <type>Number</type>
        <format>#.##</format>
        <currency/>
        <decimal>.</decimal>
        <group/>
        <length>12</length>
        <precision>2</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>type_energie</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>20</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
    </fields>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>100</xloc>
      <yloc>150</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Calculate_Margin</name>
    <type>Calculator</type>
    <description>Calculer la marge et le taux de marge</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <calculation>
      <field_name>marge</field_name>
      <calc_type>SUBTRACT</calc_type>
      <field_a>montant_ttc</field_a>
      <field_b>cout_energie</field_b>
      <field_c/>
      <value_type>Number</value_type>
      <value_length>12</value_length>
      <value_precision>2</value_precision>
      <remove>N</remove>
      <conversion_mask>#.##</conversion_mask>
      <decimal_symbol>.</decimal_symbol>
      <grouping_symbol>,</grouping_symbol>
      <currency_symbol/>
    </calculation>
    <calculation>
      <field_name>taux_marge</field_name>
      <calc_type>DIVIDE</calc_type>
      <field_a>marge</field_a>
      <field_b>montant_ttc</field_b>
      <field_c/>
      <value_type>Number</value_type>
      <value_length>5</value_length>
      <value_precision>4</value_precision>
      <remove>N</remove>
      <conversion_mask>#.####</conversion_mask>
      <decimal_symbol>.</decimal_symbol>
      <grouping_symbol>,</grouping_symbol>
      <currency_symbol/>
    </calculation>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>300</xloc>
      <yloc>150</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Read_Paiements</name>
    <type>CsvInput</type>
    <description>Lire les données de paiement (pour jointure)</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <filename>${Internal.Transformation.Filename.Directory}/../../staging/extracted/paiements_extracted.csv</filename>
    <filename_field/>
    <rownum_field/>
    <include_filename>N</include_filename>
    <separator>;</separator>
    <enclosure>&quot;</enclosure>
    <header>Y</header>
    <buffer_size>50000</buffer_size>
    <lazy_conversion>Y</lazy_conversion>
    <add_filename_result>N</add_filename_result>
    <parallel>N</parallel>
    <newline_possible>N</newline_possible>
    <encoding>UTF-8</encoding>
    <fields>
      <field>
        <name>id_paiement</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>20</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>id_facture</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>20</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>date_paiement</name>
        <type>Date</type>
        <format>yyyy-MM-dd</format>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>montant_paye</name>
        <type>Number</type>
        <format>#.##</format>
        <currency/>
        <decimal>.</decimal>
        <group/>
        <length>12</length>
        <precision>2</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>mode_paiement</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>50</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
    </fields>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>300</xloc>
      <yloc>300</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Lookup_Paiements</name>
    <type>StreamLookup</type>
    <description>Joindre avec les données de paiement</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <from>Read_Paiements</from>
    <input>
    </input>
    <output>
    </output>
    <tk>
    </tk>
    <lookup>
      <key>
        <name>id_facture</name>
        <field>id_facture</field>
      </key>
      <value>
        <name>date_paiement</name>
        <rename>date_paiement</rename>
        <default/>
        <type>Date</type>
      </value>
      <value>
        <name>montant_paye</name>
        <rename>montant_paye</rename>
        <default>0</default>
        <type>Number</type>
      </value>
      <value>
        <name>mode_paiement</name>
        <rename>mode_paiement</rename>
        <default>Non payé</default>
        <type>String</type>
      </value>
    </lookup>
    <memoryPreservationActive>Y</memoryPreservationActive>
    <usingSortedList>N</usingSortedList>
    <usingIntegerPair>N</usingIntegerPair>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>500</xloc>
      <yloc>150</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Calculate_Payment_Delay</name>
    <type>Calculator</type>
    <description>Calculer les délais de paiement en jours</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <calculation>
      <field_name>delai_paiement_jours</field_name>
      <calc_type>DATE_DIFF</calc_type>
      <field_a>date_paiement</field_a>
      <field_b>date_facture</field_b>
      <field_c/>
      <value_type>Integer</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <remove>N</remove>
      <conversion_mask/>
      <decimal_symbol/>
      <grouping_symbol/>
      <currency_symbol/>
    </calculation>
    <calculation>
      <field_name>retard_paiement_jours</field_name>
      <calc_type>DATE_DIFF</calc_type>
      <field_a>date_paiement</field_a>
      <field_b>date_echeance</field_b>
      <field_c/>
      <value_type>Integer</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <remove>N</remove>
      <conversion_mask/>
      <decimal_symbol/>
      <grouping_symbol/>
      <currency_symbol/>
    </calculation>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>700</xloc>
      <yloc>150</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Determine_Payment_Status</name>
    <type>Formula</type>
    <description>Déterminer le statut de paiement (payé, en retard)</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <formula>
      <field_name>est_paye</field_name>
      <formula>IF(ISBLANK([montant_paye]) OR [montant_paye]=0;FALSE;TRUE)</formula>
      <value_type>Boolean</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>est_en_retard</field_name>
      <formula>IF([retard_paiement_jours]&gt;0;TRUE;FALSE)</formula>
      <value_type>Boolean</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>900</xloc>
      <yloc>150</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Save_Enriched_Factures</name>
    <type>TextFileOutput</type>
    <description>Sauvegarder les factures enrichies</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <separator>;</separator>
    <enclosure>&quot;</enclosure>
    <enclosure_forced>N</enclosure_forced>
    <enclosure_fix_disabled>N</enclosure_fix_disabled>
    <header>Y</header>
    <footer>N</footer>
    <format>Unix</format>
    <compression>None</compression>
    <encoding>UTF-8</encoding>
    <endedLine/>
    <fileNameInField>N</fileNameInField>
    <fileNameField/>
    <create_parent_folder>Y</create_parent_folder>
    <file>
      <name>${Internal.Transformation.Filename.Directory}/../../staging/transformed/factures_enriched</name>
      <servlet_output>N</servlet_output>
      <do_not_open_new_file_init>N</do_not_open_new_file_init>
      <extention>csv</extention>
      <append>N</append>
      <split>N</split>
      <haspartno>N</haspartno>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <SpecifyFormat>N</SpecifyFormat>
      <date_time_format/>
      <add_to_result_filenames>Y</add_to_result_filenames>
      <pad>N</pad>
      <fast_dump>N</fast_dump>
      <splitevery>0</splitevery>
    </file>
    <fields>
    </fields>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>1100</xloc>
      <yloc>150</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step_error_handling>
  </step_error_handling>
  <slave-step-copy-partition-distribution>
  </slave-step-copy-partition-distribution>
  <slave_transformation>N</slave_transformation>
</transformation>

