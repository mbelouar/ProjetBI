<?xml version="1.0" encoding="UTF-8"?>
<transformation>
  <info>
    <name>04c_transformation_nettoyage_factures</name>
    <description>Transformation de nettoyage des données factures extraites

Opérations:
- Suppression des doublons
- Trim des espaces
- Standardisation des formats de date
- Validation des montants (>= 0)
- Traitement des valeurs manquantes</description>
    <extended_description/>
    <trans_version/>
    <trans_type>Normal</trans_type>
    <directory>/</directory>
    <parameters>
    </parameters>
    <log>
      <trans-log-table>
        <connection/>
        <schema/>
        <table/>
        <size_limit_lines/>
        <interval/>
        <timeout_days/>
        <field>
          <id>ID_BATCH</id>
          <enabled>Y</enabled>
          <name>ID_BATCH</name>
        </field>
      </trans-log-table>
    </log>
    <maxdate>
      <connection/>
      <table/>
      <field/>
      <offset>0.0</offset>
      <maxdiff>0.0</maxdiff>
    </maxdate>
    <size_rowset>10000</size_rowset>
    <sleep_time_empty>50</sleep_time_empty>
    <sleep_time_full>50</sleep_time_full>
    <unique_connections>N</unique_connections>
    <feedback_shown>Y</feedback_shown>
    <feedback_size>50000</feedback_size>
    <using_thread_priorities>Y</using_thread_priorities>
    <shared_objects_file/>
    <capture_step_performance>N</capture_step_performance>
    <step_performance_capturing_delay>1000</step_performance_capturing_delay>
    <step_performance_capturing_size_limit>100</step_performance_capturing_size_limit>
    <dependencies>
    </dependencies>
    <partitionschemas>
    </partitionschemas>
    <slaveservers>
    </slaveservers>
    <clusterschemas>
    </clusterschemas>
    <created_user>-</created_user>
    <created_date>2026/01/06 12:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/01/06 12:00:00.000</modified_date>
  </info>
  <notepads>
    <notepad>
      <note>ÉTAPE 1: Lecture des données extraites
Source: factures_extracted.csv.csv</note>
      <xloc>100</xloc>
      <yloc>50</yloc>
      <width>300</width>
      <heigth>50</heigth>
    </notepad>
    <notepad>
      <note>ÉTAPE 2: Nettoyage
- Suppression doublons
- Trim espaces
- Standardisation dates
- Validation montants >= 0</note>
      <xloc>350</xloc>
      <yloc>50</yloc>
      <width>250</width>
      <heigth>80</heigth>
    </notepad>
    <notepad>
      <note>ÉTAPE 3: Sauvegarde
Fichier nettoyé: factures_cleaned.csv</note>
      <xloc>650</xloc>
      <yloc>50</yloc>
      <width>250</width>
      <heigth>50</heigth>
    </notepad>
  </notepads>
  <order>
    <hop>
      <from>Read_Extracted_Factures</from>
      <to>Sort_By_ID_Facture</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Sort_By_ID_Facture</from>
      <to>Remove_Duplicates</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Remove_Duplicates</from>
      <to>Trim_Spaces</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Trim_Spaces</from>
      <to>Handle_Null_Values</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Handle_Null_Values</from>
      <to>Standardize_Date_Formats</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Standardize_Date_Formats</from>
      <to>Validate_Numeric_Values</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Validate_Numeric_Values</from>
      <to>Save_Cleaned_Factures</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <step>
    <name>Read_Extracted_Factures</name>
    <type>CsvInput</type>
    <description>Lire les données factures extraites de MySQL</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <filename>${Internal.Transformation.Filename.Directory}/../../staging/extracted/factures_extracted.csv.csv</filename>
    <filename_field/>
    <rownum_field/>
    <include_filename>N</include_filename>
    <separator>;</separator>
    <enclosure>&quot;</enclosure>
    <header>Y</header>
    <buffer_size>50000</buffer_size>
    <lazy_conversion>Y</lazy_conversion>
    <add_filename_result>N</add_filename_result>
    <parallel>N</parallel>
    <newline_possible>N</newline_possible>
    <encoding>UTF-8</encoding>
    <fields>
      <field>
        <name>id_facture</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>20</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>numero_facture</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>50</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>id_client</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>10</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>id_batiment</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>10</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>id_type_energie</name>
        <type>Integer</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>1</length>
        <precision>0</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>date_facture</name>
        <type>Date</type>
        <format>yyyy/MM/dd HH:mm:ss.SSS</format>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>date_echeance</name>
        <type>Date</type>
        <format>yyyy/MM/dd HH:mm:ss.SSS</format>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>periode_debut</name>
        <type>Date</type>
        <format>yyyy/MM/dd HH:mm:ss.SSS</format>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>periode_fin</name>
        <type>Date</type>
        <format>yyyy/MM/dd HH:mm:ss.SSS</format>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>consommation_quantite</name>
        <type>Number</type>
        <format>#.##</format>
        <currency/>
        <decimal>.</decimal>
        <group/>
        <length>12</length>
        <precision>2</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>prix_unitaire</name>
        <type>Number</type>
        <format>#.####</format>
        <currency/>
        <decimal>.</decimal>
        <group/>
        <length>10</length>
        <precision>4</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>montant_ht</name>
        <type>Number</type>
        <format>#.##</format>
        <currency/>
        <decimal>.</decimal>
        <group/>
        <length>12</length>
        <precision>2</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>taux_tva</name>
        <type>Number</type>
        <format>#.####</format>
        <currency/>
        <decimal>.</decimal>
        <group/>
        <length>5</length>
        <precision>4</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>montant_tva</name>
        <type>Number</type>
        <format>#.##</format>
        <currency/>
        <decimal>.</decimal>
        <group/>
        <length>12</length>
        <precision>2</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>montant_ttc</name>
        <type>Number</type>
        <format>#.##</format>
        <currency/>
        <decimal>.</decimal>
        <group/>
        <length>12</length>
        <precision>2</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>cout_energie</name>
        <type>Number</type>
        <format>#.##</format>
        <currency/>
        <decimal>.</decimal>
        <group/>
        <length>12</length>
        <precision>2</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>statut_facture</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>20</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>date_creation</name>
        <type>Date</type>
        <format>yyyy/MM/dd HH:mm:ss.SSSSSSSSS</format>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>date_modification</name>
        <type>Date</type>
        <format>yyyy/MM/dd HH:mm:ss.SSSSSSSSS</format>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
    </fields>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>100</xloc>
      <yloc>150</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Sort_By_ID_Facture</name>
    <type>SortRows</type>
    <description>Trier par ID facture pour détecter les doublons</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <directory>%%java.io.tmpdir%%</directory>
    <prefix>out</prefix>
    <sort_size>1000000</sort_size>
    <free_memory/>
    <compress>N</compress>
    <compress_variable/>
    <unique_rows>N</unique_rows>
    <fields>
      <field>
        <name>id_facture</name>
        <ascending>Y</ascending>
        <case_sensitive>N</case_sensitive>
        <presorted>N</presorted>
      </field>
    </fields>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>250</xloc>
      <yloc>150</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Remove_Duplicates</name>
    <type>UniqueRows</type>
    <description>Supprimer les doublons basés sur id_facture</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <count_rows>N</count_rows>
    <count_field>duplicates</count_field>
    <reject_duplicate_row>Y</reject_duplicate_row>
    <error_description/>
    <fields>
      <field>
        <name>id_facture</name>
        <case_insensitive>N</case_insensitive>
      </field>
    </fields>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>400</xloc>
      <yloc>150</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Trim_Spaces</name>
    <type>StringOperations</type>
    <description>Supprimer les espaces avant/après sur les champs texte</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <in_stream_name>id_facture</in_stream_name>
        <out_stream_name/>
        <trim_type>both</trim_type>
        <lower_upper>none</lower_upper>
        <padding_type>none</padding_type>
        <pad_char/>
        <pad_len/>
        <init_cap>no</init_cap>
        <mask_xml>none</mask_xml>
        <digits>none</digits>
        <remove_special_characters>none</remove_special_characters>
      </field>
      <field>
        <in_stream_name>numero_facture</in_stream_name>
        <out_stream_name/>
        <trim_type>both</trim_type>
        <lower_upper>none</lower_upper>
        <padding_type>none</padding_type>
        <pad_char/>
        <pad_len/>
        <init_cap>no</init_cap>
        <mask_xml>none</mask_xml>
        <digits>none</digits>
        <remove_special_characters>none</remove_special_characters>
      </field>
      <field>
        <in_stream_name>id_client</in_stream_name>
        <out_stream_name/>
        <trim_type>both</trim_type>
        <lower_upper>none</lower_upper>
        <padding_type>none</padding_type>
        <pad_char/>
        <pad_len/>
        <init_cap>no</init_cap>
        <mask_xml>none</mask_xml>
        <digits>none</digits>
        <remove_special_characters>none</remove_special_characters>
      </field>
      <field>
        <in_stream_name>id_batiment</in_stream_name>
        <out_stream_name/>
        <trim_type>both</trim_type>
        <lower_upper>upper</lower_upper>
        <padding_type>none</padding_type>
        <pad_char/>
        <pad_len/>
        <init_cap>no</init_cap>
        <mask_xml>none</mask_xml>
        <digits>none</digits>
        <remove_special_characters>none</remove_special_characters>
      </field>
      <field>
        <in_stream_name>statut_facture</in_stream_name>
        <out_stream_name/>
        <trim_type>both</trim_type>
        <lower_upper>none</lower_upper>
        <padding_type>none</padding_type>
        <pad_char/>
        <pad_len/>
        <init_cap>no</init_cap>
        <mask_xml>none</mask_xml>
        <digits>none</digits>
        <remove_special_characters>none</remove_special_characters>
      </field>
    </fields>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>550</xloc>
      <yloc>150</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Handle_Null_Values</name>
    <type>IfNull</type>
    <description>Remplacer les valeurs NULL par des valeurs par défaut</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <replaceAllByValue/>
    <replaceAllMask/>
    <selectFields>Y</selectFields>
    <selectValuesType>N</selectValuesType>
    <setEmptyStringAll>N</setEmptyStringAll>
    <valuetypes/>
    <fields>
      <field>
        <name>numero_facture</name>
        <value>N/A</value>
        <mask/>
      </field>
      <field>
        <name>montant_ht</name>
        <value>0</value>
        <mask/>
      </field>
      <field>
        <name>montant_ttc</name>
        <value>0</value>
        <mask/>
      </field>
      <field>
        <name>cout_energie</name>
        <value>0</value>
        <mask/>
      </field>
      <field>
        <name>consommation_quantite</name>
        <value>0</value>
        <mask/>
      </field>
    </fields>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>700</xloc>
      <yloc>150</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Standardize_Date_Formats</name>
    <type>SelectValues</type>
    <description>Standardiser les formats de date (yyyy-MM-dd)</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <select_unspecified>Y</select_unspecified>
      <meta>
        <name>date_facture</name>
        <rename/>
        <type>Date</type>
        <length>-2</length>
        <precision>-2</precision>
        <conversion_mask>yyyy-MM-dd</conversion_mask>
        <date_format_lenient>false</date_format_lenient>
        <date_format_locale/>
        <date_format_timezone/>
        <lenient_string_to_number>false</lenient_string_to_number>
        <encoding/>
        <decimal_symbol/>
        <grouping_symbol/>
        <currency_symbol/>
        <storage_type/>
      </meta>
      <meta>
        <name>date_echeance</name>
        <rename/>
        <type>Date</type>
        <length>-2</length>
        <precision>-2</precision>
        <conversion_mask>yyyy-MM-dd</conversion_mask>
        <date_format_lenient>false</date_format_lenient>
        <date_format_locale/>
        <date_format_timezone/>
        <lenient_string_to_number>false</lenient_string_to_number>
        <encoding/>
        <decimal_symbol/>
        <grouping_symbol/>
        <currency_symbol/>
        <storage_type/>
      </meta>
      <meta>
        <name>periode_debut</name>
        <rename/>
        <type>Date</type>
        <length>-2</length>
        <precision>-2</precision>
        <conversion_mask>yyyy-MM-dd</conversion_mask>
        <date_format_lenient>false</date_format_lenient>
        <date_format_locale/>
        <date_format_timezone/>
        <lenient_string_to_number>false</lenient_string_to_number>
        <encoding/>
        <decimal_symbol/>
        <grouping_symbol/>
        <currency_symbol/>
        <storage_type/>
      </meta>
      <meta>
        <name>periode_fin</name>
        <rename/>
        <type>Date</type>
        <length>-2</length>
        <precision>-2</precision>
        <conversion_mask>yyyy-MM-dd</conversion_mask>
        <date_format_lenient>false</date_format_lenient>
        <date_format_locale/>
        <date_format_timezone/>
        <lenient_string_to_number>false</lenient_string_to_number>
        <encoding/>
        <decimal_symbol/>
        <grouping_symbol/>
        <currency_symbol/>
        <storage_type/>
      </meta>
      <meta>
        <name>date_creation</name>
        <rename/>
        <type>Date</type>
        <length>-2</length>
        <precision>-2</precision>
        <conversion_mask>yyyy-MM-dd HH:mm:ss</conversion_mask>
        <date_format_lenient>false</date_format_lenient>
        <date_format_locale/>
        <date_format_timezone/>
        <lenient_string_to_number>false</lenient_string_to_number>
        <encoding/>
        <decimal_symbol/>
        <grouping_symbol/>
        <currency_symbol/>
        <storage_type/>
      </meta>
      <meta>
        <name>date_modification</name>
        <rename/>
        <type>Date</type>
        <length>-2</length>
        <precision>-2</precision>
        <conversion_mask>yyyy-MM-dd HH:mm:ss</conversion_mask>
        <date_format_lenient>false</date_format_lenient>
        <date_format_locale/>
        <date_format_timezone/>
        <lenient_string_to_number>false</lenient_string_to_number>
        <encoding/>
        <decimal_symbol/>
        <grouping_symbol/>
        <currency_symbol/>
        <storage_type/>
      </meta>
    </fields>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>850</xloc>
      <yloc>150</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Validate_Numeric_Values</name>
    <type>FilterRows</type>
    <description>Valider que tous les montants >= 0</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>Save_Cleaned_Factures</send_true_to>
    <send_false_to>Invalid_Data_Log</send_false_to>
    <condition>montant_ht &gt;= 0 AND montant_ttc &gt;= 0 AND cout_energie &gt;= 0 AND consommation_quantite &gt;= 0</condition>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>1000</xloc>
      <yloc>150</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Save_Cleaned_Factures</name>
    <type>TextFileOutput</type>
    <description>Sauvegarder les données nettoyées en CSV</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <separator>;</separator>
    <enclosure>&quot;</enclosure>
    <enclosure_forced>N</enclosure_forced>
    <enclosure_fix_disabled>N</enclosure_fix_disabled>
    <header>Y</header>
    <footer>N</footer>
    <format>Unix</format>
    <compression>None</compression>
    <encoding>UTF-8</encoding>
    <endedLine/>
    <fileNameInField>N</fileNameInField>
    <fileNameField/>
    <create_parent_folder>Y</create_parent_folder>
    <file>
      <name>${Internal.Transformation.Filename.Directory}/../../staging/transformed/factures_cleaned</name>
      <servlet_output>N</servlet_output>
      <do_not_open_new_file_init>N</do_not_open_new_file_init>
      <extention>csv</extention>
      <append>N</append>
      <split>N</split>
      <haspartno>N</haspartno>
      <add_date>N</add_date>
